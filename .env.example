# 楽天ウェブサービス（https://webservice.rakuten.co.jp/ でアプリ登録）
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 楽天アフィリエイトID（例: 1234abcd.5678efgh.1234abcd.5678efgh）
RAKUTEN_AFFILIATE_ID=
# Amazonアソシエイト トラッキングID（例: yourname-22）
AMAZON_ASSOCIATE_TAG=
# PA-API / Creators API（売上実績ができてから。いまは未使用のスタブ）
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
# 楽天ROOM のプロフィールURL（例: https://room.rakuten.co.jp/room_xxxxxx/items）
RAKUTEN_ROOM_URL=
# 公開URL（楽天アプリの「許可Webサイト」と同じドメイン）
SITE_URL=
SITE_NAME=わんこ用品ナビ
ROOM_PAGE_SLUG=room-posts
